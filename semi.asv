% --- Executes on button press in orirad.
function orirad_Callback(hObject, eventdata, handles)
% hObject    handle to orirad (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hint: get(hObject,'Value') returns toggle state of orirad
set(handles.orirad,'value','1');
set(handles.ori,'enable','on');
set(handles.enc,'enable','off');
set(handles.encrad,'value','0');


% --- Executes on button press in encrad.
function encrad_Callback(hObject, eventdata, handles)
% hObject    handle to encrad (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

